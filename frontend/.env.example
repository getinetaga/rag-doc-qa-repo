# RAG TypeScript React App - Environment Configuration

# API Configuration
# ==================
# The backend FastAPI server address
VITE_API_URL=http://127.0.0.1:8000

# Application Settings
# ====================
# Timeout for file upload in milliseconds
VITE_UPLOAD_TIMEOUT=60000

# Timeout for question answering in milliseconds
VITE_QUESTION_TIMEOUT=60000

# Maximum file size in bytes (default 200 MiB)
VITE_MAX_FILE_SIZE=209715200

# API Health Check
# ================
# Enable periodic API health checks
VITE_HEALTH_CHECK_ENABLED=true

# Health check interval in milliseconds
VITE_HEALTH_CHECK_INTERVAL=5000

# Development Settings
# ====================
# Enable debug logging in browser console
VITE_DEBUG=false

# Enable detailed API request/response logging
VITE_DEBUG_API=false

# UI Customization
# ================
# Application title
VITE_APP_TITLE=RAG Document QA System

# Application subtitle
VITE_APP_SUBTITLE=Upload documents and ask AI-powered questions

# Primary color (hex)
VITE_PRIMARY_COLOR=#1E88E5

# Chat history display limit (0 = unlimited)
VITE_CHAT_HISTORY_LIMIT=0

# Auto-scroll to latest message
VITE_AUTO_SCROLL=true

# Supported file types (comma-separated)
VITE_SUPPORTED_FILES=pdf,docx,txt

# Authentication and scope
# ========================
# Enter your individual API key in the sign-in screen, never in VITE_* variables.
# Keys remain in memory only. Refreshing the page requires signing in again.
# Tenant/project grants and roles are returned by the authenticated GET /session.
# All API requests include a Bearer token; 401 signs out and clears the workspace.
# Roles are explicit: admin does not imply read or ingest.
# Read-only users can query existing documents; uploads require ingest.
# SharePoint ingestion requires both ingest and admin.
# Queued uploads are polled for at most five minutes before a timeout is shown.
# Cancel stops waiting locally; an accepted server job may still complete.

# Notes:
# - These variables must be prefixed with VITE_ to be accessible in the React app
# - Change values in .env.local for development overrides
# - For production, create a .env.production file
# - Never put API keys or other secrets in frontend environment files or build config
# - Current API address is configured in src/constants.ts; this example documents
#   intended VITE_* settings, which are not currently loaded by the application.
